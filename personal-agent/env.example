# Telegram Bot API token from @BotFather
BOT_TOKEN=

# Локальный запуск (start-bot.bat) — только для разработки!
# На сервере Oracle НЕ ставьте. Иначе два бота с одним токеном конфликтуют.
# ALLOW_LOCAL_BOT=true

# OpenAI: task parsing, voice (Whisper), AI chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# Default timezone for users without explicit setting
DEFAULT_TIMEZONE=Europe/Moscow

# SQLite database path (created automatically)
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# Sync URL for APScheduler job store
SCHEDULER_DATABASE_URL=sqlite:///./data/scheduler.db

# TTS voice for call-style reminders (edge-tts, Russian)
TTS_VOICE=ru-RU-DmitryNeural

# Google Calendar OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ai-agency-drab.vercel.app/api/google/oauth/callback
OAUTH_SERVER_PORT=8080
PERSONAL_AGENT_INTERNAL_SECRET=change-me-in-production

# Twilio phone calls (https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

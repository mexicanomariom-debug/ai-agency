# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=repetitors_ai_bot

# OpenAI (Whisper STT + TTS + embeddings)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_TTS_VOICE=shimmer
OPENAI_TTS_MODEL=tts-1-hd

# Anthropic (Claude — основной LLM для учителя, приоритет над OpenAI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# Database
POSTGRES_USER=language_tutor
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=language_tutor
DATABASE_URL=postgresql+asyncpg://language_tutor:change_me_strong_password@db:5432/language_tutor

# Web App (Vercel)
TWA_URL=https://webapp-bay-three-75.vercel.app
WEBAPP_URL=https://webapp-bay-three-75.vercel.app
API_URL=http://localhost:8000
CORS_ORIGINS=https://webapp-bay-three-75.vercel.app

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production
WEBHOOK_URL=
WEBHOOK_SECRET=

# Demo mode: allows API access without Telegram auth (X-Demo-Mode header).
# Required by the webapp /app and /voice pages outside Telegram.
# SECURITY: with DEMO_MODE=true the API is unauthenticated — anyone can spend
# your OpenAI/Anthropic quota. Set false if the webapp is not needed.
DEMO_MODE=true

# Environment
ENVIRONMENT=development
